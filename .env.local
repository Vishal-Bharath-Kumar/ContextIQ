# .env.local — ContextIQ local development environment variables
#
# Usage:
#   cp .env.local .env
#   # Edit .env and fill in required API keys before running docker compose up
#
# Most values are already set in docker-compose.yml via the x-app-env block.
# This file only needs values that are NOT infrastructure-derived
# (LLM API keys, external service keys, etc.)
#
# IMPORTANT: Never commit .env to source control.

# ---------------------------------------------------------------------------
# REQUIRED — LLM / AI Provider
# Set at least one of these to enable the AI features.
# ---------------------------------------------------------------------------

# OpenAI (used by summarisation and model router)
OPENAI_API_KEY="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"
GEMINI_API_KEY="AIzaSyBYXpvKYzIZoMTPv6PeyT-IyN7ypLa96VM"
# Anthropic (optional — for Claude models)
# ANTHROPIC_API_KEY=sk-ant-...

# GitHub connector (optional — used by local Vault bootstrap for real connector retrieval)
# GITHUB_CONNECTOR_TOKEN=ghp_your_real_pat_here
# GITHUB_CONNECTOR_REPOS=["owner/repo"]

# Azure OpenAI (optional)
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-05-01-preview

# ---------------------------------------------------------------------------
# OPTIONAL — Langfuse Observability
# Langfuse provides comprehensive LLM tracing, cost tracking, and observability.
# See docs/LANGFUSE_INTEGRATION.md for usage guide.
# ---------------------------------------------------------------------------
LANGFUSE_ENABLED=true
LANGFUSE_SECRET_KEY="sk-lf-6d757fa2-f103-4e1a-aacf-3de32b277405"
LANGFUSE_PUBLIC_KEY="pk-lf-1bb2f22c-db12-4b39-b1c8-a5ac81cf56ea"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
# ---------------------------------------------------------------------------
# OPTIONAL — Context7 (used by .github Copilot instructions)
# ---------------------------------------------------------------------------
# CONTEXT7_API_KEY=ctx7sk-...

# ---------------------------------------------------------------------------
# Model Router — default model settings
# ---------------------------------------------------------------------------
SUMMARIZATION_MODEL_NAME=gpt-4o-mini
SUMMARIZATION_TOKEN_THRESHOLD=500
SUMMARIZATION_LANGFUSE_ENABLED=false

# ---------------------------------------------------------------------------
# Gateway core
# ---------------------------------------------------------------------------
CONTEXTIQ_MCP_PATH=/mcp
CONTEXTIQ_SERVER_VERSION=0.1.0-local
CONTEXTIQ_LOG_LEVEL=DEBUG

# ---------------------------------------------------------------------------
# The values below are set automatically by docker-compose.yml.
# Override here ONLY if you need non-default values.
# ---------------------------------------------------------------------------

# PostgreSQL
# DATABASE_URL=postgresql+asyncpg://contextiq:contextiq_dev@postgres:5432/contextiq
# DATABASE_READ_URL=postgresql+asyncpg://contextiq:contextiq_dev@postgres:5432/contextiq

# Redis
# REDIS_SENTINEL_HOSTS=redis-sentinel:26379
# REDIS_SENTINEL_MASTER=contextiq-redis
# REDIS_PASSWORD=contextiq_dev
# REDIS_URL=rediss://:contextiq_dev@redis:6379/0

# Kafka
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# KAFKA_USERNAME=contextiq
# KAFKA_PASSWORD=contextiq_dev

# Qdrant
# QDRANT_URL=http://qdrant:6333

# Neo4j
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=contextiq_dev

# MinIO
# AUDIT_ARCHIVE_MINIO_ENDPOINT=http://minio:9000
# AUDIT_ARCHIVE_MINIO_ACCESS_KEY=contextiq
# AUDIT_ARCHIVE_MINIO_SECRET_KEY=contextiq_dev

# Keycloak
# KEYCLOAK_URL=http://keycloak:8080/auth
# KEYCLOAK_REALM=contextiq
# KEYCLOAK_AUDIENCE=contextiq-mcp-gateway

# Jaeger
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# Agent Worker
# CONTEXTIQ_AGENT_WORKER_BASE_URL=http://agent-worker:8001
