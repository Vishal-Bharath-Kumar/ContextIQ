# Root .gitignore for ContextIQ
# Ignore Node modules everywhere
node_modules/
**/node_modules/

# Build output / bundles
dist/
**/dist/
build/
**/build/
out/
**/out/
.vite/
**/.vite/
.cache/
**/.cache/

# Frontend/admin-portal explicit (redundant with patterns above but clearer)
frontend/admin-portal/node_modules/
frontend/admin-portal/dist/

# Env files (do not commit secrets)
.env
.env.local
.env.*.local
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log

# TypeScript
*.tsbuildinfo

# Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
env/

# Test coverage
coverage/
.nyc_output/

# Misc
*.tgz
dist-*
