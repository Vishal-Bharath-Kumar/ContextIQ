exports[`ConnectorStatusBadge > renders 'Active' badge with correct aria-label 1`] = `
<span
  aria-label="Connector status: Active"
  class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium badge-green"
>
  Active
</span>
`;

