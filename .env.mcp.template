# ContextIQ Environment Configuration Template
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to version control!

# ────────────────────────────────────────────────────────────────────────────
# MCP Authentication
# ────────────────────────────────────────────────────────────────────────────

# JWT token for local development - obtain from ContextIQ auth service
CONTEXTIQ_TOKEN=

# Production JWT token (if applicable)
CONTEXTIQ_PROD_TOKEN=

# ────────────────────────────────────────────────────────────────────────────
# MCP Configuration
# ────────────────────────────────────────────────────────────────────────────

# MCP Gateway endpoint (default: http://localhost:8080)
CONTEXTIQ_MCP_URL=http://localhost:8080/mcp/sse

# Production MCP endpoint
CONTEXTIQ_PROD_URL=

# Request timeout in milliseconds (default: 30000)
CONTEXTIQ_MCP_TIMEOUT=30000

# ────────────────────────────────────────────────────────────────────────────
# Repository Configuration
# ────────────────────────────────────────────────────────────────────────────

# Default repository identifier for MCP requests
CONTEXTIQ_REPOSITORY=

# Project identifier
CONTEXTIQ_PROJECT=

# Team identifier
CONTEXTIQ_TEAM=

# Environment (dev, staging, prod)
CONTEXTIQ_ENVIRONMENT=dev

# ────────────────────────────────────────────────────────────────────────────
# Gateway Settings
# ────────────────────────────────────────────────────────────────────────────

# MCP endpoint path prefix (default: /mcp)
CONTEXTIQ_MCP_PATH=/mcp

# Gateway version
CONTEXTIQ_SERVER_VERSION=0.1.0

# Log level (DEBUG, INFO, WARNING, ERROR)
CONTEXTIQ_LOG_LEVEL=INFO

# ────────────────────────────────────────────────────────────────────────────
# Database
# ────────────────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://contextiq:contextiq@postgres:5432/contextiq

# ────────────────────────────────────────────────────────────────────────────
# Redis
# ────────────────────────────────────────────────────────────────────────────

CONTEXTIQ_REDIS_URL=redis://redis:6379/0

# ────────────────────────────────────────────────────────────────────────────
# OpenTelemetry (Observability)
# ────────────────────────────────────────────────────────────────────────────

OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger-collector:4317
OTEL_TRACES_SAMPLER_ARG=1.0

# ────────────────────────────────────────────────────────────────────────────
# Vault (Secrets Management)
# ────────────────────────────────────────────────────────────────────────────

VAULT_ADDR=http://vault:8200
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# ────────────────────────────────────────────────────────────────────────────
# Keycloak (Authentication)
# ────────────────────────────────────────────────────────────────────────────

KEYCLOAK_URL=http://keycloak:8080
CONTEXTIQ_KEYCLOAK_CLIENT_ID=contextiq-gateway

# ────────────────────────────────────────────────────────────────────────────
# Agent Worker
# ────────────────────────────────────────────────────────────────────────────

CONTEXTIQ_AGENT_WORKER_BASE_URL=http://contextiq-agent-worker:8080
CONTEXTIQ_AGENT_WORKER_TIMEOUT_SECONDS=5.0

# ────────────────────────────────────────────────────────────────────────────
# Context7 API (MCP Documentation Search)
# ────────────────────────────────────────────────────────────────────────────

# Get your API key at: https://context7.ai
CONTEXT7_API_KEY=

# ────────────────────────────────────────────────────────────────────────────
# Optional: External MCP Servers
# ────────────────────────────────────────────────────────────────────────────

# PropelSDLC MCP Server
PROPEL_MCP_URL=

# Custom MCP Server URLs
CUSTOM_MCP_SERVER_1_URL=
CUSTOM_MCP_SERVER_1_TOKEN=

# ────────────────────────────────────────────────────────────────────────────
# Development Settings
# ────────────────────────────────────────────────────────────────────────────

# Enable debug mode (true/false)
DEBUG=false

# Enable JWT auth (true/false) - set to false for local dev
CONTEXTIQ_JWT_AUTH_ENABLED=false

# ────────────────────────────────────────────────────────────────────────────
# Multi-Repository Setup (Optional)
# ────────────────────────────────────────────────────────────────────────────

# Tokens for specific repositories
CONTEXTIQ_TOKEN_FRONTEND=
CONTEXTIQ_TOKEN_BACKEND=
CONTEXTIQ_TOKEN_INFRA=

# Repository identifiers
REPOSITORY_FRONTEND=frontend-app
REPOSITORY_BACKEND=backend-api
REPOSITORY_INFRA=infrastructure

# ────────────────────────────────────────────────────────────────────────────
# Production Settings (Optional)
# ────────────────────────────────────────────────────────────────────────────

# Production database
DATABASE_URL_PROD=

# Production Redis
CONTEXTIQ_REDIS_URL_PROD=

# Production Vault
VAULT_ADDR_PROD=

# ────────────────────────────────────────────────────────────────────────────
# NOTES
# ────────────────────────────────────────────────────────────────────────────
#
# 1. SECURITY: Add .env to .gitignore to prevent committing secrets
#    echo .env >> .gitignore
#
# 2. TOKEN FORMAT: JWT tokens should be in the format:
#    eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9...
#
# 3. MULTIPLE ENVIRONMENTS: Create separate files for each environment:
#    - .env.development
#    - .env.staging
#    - .env.production
#
# 4. DOCKER COMPOSE: This file is automatically loaded by docker-compose.yml
#
# 5. SHELL INTEGRATION: Source this file in your shell profile:
#    set -a; source .env; set +a
#
# 6. VALIDATION: Test your configuration with:
#    docker compose config
#
# ────────────────────────────────────────────────────────────────────────────
