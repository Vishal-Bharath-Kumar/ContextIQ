# LLM Provider API Keys (for model invocation via LiteLLM)
OPENAI_API_KEY=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

# ContextIQ Gateway — Environment Variable Reference
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to source control.

# ---------------------------------------------------------------------------
# Gateway core
# ---------------------------------------------------------------------------
CONTEXTIQ_MCP_PATH=/mcp
CONTEXTIQ_SERVER_VERSION=0.1.0
CONTEXTIQ_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# OpenTelemetry — TASK-US001-05
#
# OTEL_EXPORTER_OTLP_ENDPOINT   gRPC endpoint of the OTLP collector.
#                                In-cluster default: http://jaeger-collector:4317
#
# OTEL_TRACES_SAMPLER_ARG       TraceIdRatio sampler probability [0.0 – 1.0].
#                                1.0 = 100% sampling (default).
#                                Set to 0.1 for 10% in high-traffic environments.
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger-collector:4317
OTEL_TRACES_SAMPLER_ARG=1.0

# ---------------------------------------------------------------------------
# Agent Worker — TASK-US003-02
#
# CONTEXTIQ_AGENT_WORKER_BASE_URL      Base URL of the Agent Worker service.
#                                       In-cluster default points to the K8s
#                                       service DNS name.
#
# CONTEXTIQ_AGENT_WORKER_TIMEOUT_SECONDS  Hard request timeout in seconds.
#                                          Default: 5.0 (SLA buffer above the
#                                          p95 < 3 s target).
# ---------------------------------------------------------------------------
CONTEXTIQ_AGENT_WORKER_BASE_URL=http://contextiq-agent-worker.contextiq-agents.svc.cluster.local
CONTEXTIQ_AGENT_WORKER_TIMEOUT_SECONDS=5.0

# ---------------------------------------------------------------------------
# Vault — TASK-US003-02 (EP-TECH-002)
#
# CONTEXTIQ_VAULT_ADDR   Vault server address for service token issuance.
# CONTEXTIQ_VAULT_ROLE   PKI role name used to issue short-lived certificates.
# ---------------------------------------------------------------------------
CONTEXTIQ_VAULT_ADDR=http://vault.vault.svc.cluster.local:8200
CONTEXTIQ_VAULT_ROLE=contextiq-gateway

# ---------------------------------------------------------------------------
# Keycloak JWT Authentication — TASK-US004-01 / TASK-US004-02
#
# KEYCLOAK_JWKS_URI   Full URL of the Keycloak JWKS endpoint.
#                     Override when Keycloak URL or realm differs from defaults.
#
# JWT_AUDIENCE        Expected `aud` claim value in inbound JWTs.
#                     Must match the Keycloak client ID configured for the gateway.
# ---------------------------------------------------------------------------
KEYCLOAK_JWKS_URI=http://keycloak.keycloak.svc.cluster.local/auth/realms/contextiq/protocol/openid-connect/certs
JWT_AUDIENCE=contextiq-mcp-gateway

# Ollama - Local LLM inference (no API costs)
OLLAMA_BASE_URL=http://host.docker.internal:11434
