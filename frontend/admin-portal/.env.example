# ContextIQ Admin Portal - Environment Configuration

# API Configuration
# The base URL for the ContextIQ API
# Default: /api (proxied to http://localhost:8000 in development via vite.config.ts)
VITE_API_BASE_URL=/api

# For production deployment, set to your actual API URL:
# VITE_API_BASE_URL=https://api.contextiq.example.com
